# clang-tidy baseline for annex (checked with clang-tidy 18).
# Goal: catch real bugs and missed optimisations without drowning the signal.
# Only project headers are analysed; CI does not treat warnings as errors yet.
---
Checks: >
  -*,
  bugprone-*,
  performance-*,
  modernize-*,
  readability-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-missing-std-forward,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-rvalue-reference-param-not-moved,
  cppcoreguidelines-slicing,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-virtual-class-destructor,
  -bugprone-easily-swappable-parameters,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-uppercase-literal-suffix,
  -readability-avoid-unconditional-preprocessor-if

# Why the disabled checks are off:
#   bugprone-easily-swappable-parameters: every kernel takes (const float* a,
#     const float* b, size_t dim); flagging that signature everywhere is noise.
#   modernize-use-trailing-return-type: style preference, not a defect.
#   readability-magic-numbers: SIMD widths, unroll factors and default graph
#     parameters (M, ef) are clearer as literals at the point of use.
#   readability-identifier-length: a, b, i, k, n, M are idiomatic in numeric code.
#   readability-function-cognitive-complexity: graph search and SIMD loops are
#     inherently branchy; keep reviews, not a metric, as the guard.
#   readability-uppercase-literal-suffix: 1.0f is as clear as 1.0F.
#   readability-avoid-unconditional-preprocessor-if: `#if 0` is fine for
#     temporarily disabled code.
#
# cppcoreguidelines-* is enabled selectively. Deliberately NOT enabled:
#   pro-bounds-pointer-arithmetic, pro-bounds-constant-array-index,
#   pro-bounds-array-to-pointer-decay: distance kernels walk raw float
#     buffers and SIMD intrinsics need raw pointers; this is unavoidable.
#   pro-type-reinterpret-cast: needed for aligned loads and binary I/O.
#   avoid-magic-numbers, owning-memory, non-private-member-variables-in-classes,
#   avoid-c-arrays: aliases or noisy duplicates of the checks above.

WarningsAsErrors: ''

# Only report diagnostics from this project's headers (include/annex/ and
# src/), not system or third-party ones (/usr/include, pybind11, GoogleTest,
# Google Benchmark).
HeaderFilterRegex: '(^|.*/)(include/annex|src)/.*'

FormatStyle: file

CheckOptions:
  # Allow `explicit operator bool` style implicit conversions in conditions.
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: true
  - key: readability-implicit-bool-conversion.AllowIntegerConditions
    value: true
  # Rule-of-five: `= default` destructors alone do not demand the full set.
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: true
  # Function size: a very relaxed ceiling rather than cognitive complexity.
  - key: readability-function-size.LineThreshold
    value: 200
  - key: readability-function-size.StatementThreshold
    value: 400
  # Brace-less single-statement `if` is allowed by Google style.
  - key: readability-braces-around-statements.ShortStatementLines
    value: 2
...
